<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Fresh Fire Prayers - powerful prayers for every circumstance.">
  <title>Fresh Fire Prayers</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../css/styles.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="#top" aria-label="Fresh Fire Prayers home">
      <span class="brand-mark" aria-hidden="true">✦</span>
      <span>Fresh Fire<br><strong>Prayers</strong></span>
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      <a href="#prayers">Prayers</a>
      <a href="#purpose">Our purpose</a>
      <a class="nav-button" href="#share">Share a prayer</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero section-frame">
      <div class="hero-copy">
        <p class="eyebrow">Powerful prayers for every circumstance</p>
        <h1>Keep the<br><span>fire burning.</span></h1>
        <p class="hero-intro">A place to pause, believe, and pray with courage. Whatever today holds, you do not have to face it alone.</p>
        <a class="primary-button" href="#prayers">Find your prayer <span aria-hidden="true">↘</span></a>
      </div>
      <div class="hero-flame" aria-label="A stylized flame illustration" role="img">
        <div class="flame flame-back"></div>
        <div class="flame flame-main"></div>
        <div class="flame flame-core"></div>
      </div>
    </section>

    <section class="prompt-grid section-frame" id="purpose" aria-labelledby="prompt-title">
      <div class="section-heading">
        <p class="eyebrow">Start here</p>
        <h2 id="prompt-title">Bring your whole<br><span>story to God.</span></h2>
      </div>
      <div class="prompt-list">
        <article class="prompt-card"><span class="prompt-number">01</span><h3>Who</h3><p>Who are you praying for today? Name them with love.</p></article>
        <article class="prompt-card"><span class="prompt-number">02</span><h3>What</h3><p>What burden, hope, or need are you placing before God?</p></article>
        <article class="prompt-card"><span class="prompt-number">03</span><h3>When</h3><p>When can you make space to be still and listen?</p></article>
        <article class="prompt-card"><span class="prompt-number">04</span><h3>Why</h3><p>Why does this prayer matter deeply to your heart?</p></article>
      </div>
    </section>

    <section class="prayer-section section-frame" id="prayers" aria-labelledby="prayer-title">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">Choose your moment</p>
          <h2 id="prayer-title">A prayer for<br><span>right now.</span></h2>
        </div>
        <p class="section-note">Short, honest prayers for the places life takes you. Read slowly. Let the words become your own.</p>
      </div>
      <div class="prayer-grid">
        <article class="prayer-card featured"><span class="card-label">For strength</span><h3>When the road feels heavy</h3><p>God, meet me in this moment. Give me strength for the next step, wisdom for the next choice, and peace that does not depend on my circumstances. Keep my heart steady and my hope alive. Amen.</p><a href="#share" aria-label="Save prayer for strength">Save prayer <span aria-hidden="true">↗</span></a></article>
        <article class="prayer-card"><span class="card-label">For peace</span><h3>When your mind will not rest</h3><p>Let peace settle over my thoughts like a quiet morning. Help me release what I cannot control and trust You with what comes next.</p><a href="#share" aria-label="Save prayer for peace">Save prayer <span aria-hidden="true">↗</span></a></article>
        <article class="prayer-card"><span class="card-label">For hope</span><h3>When you need a new beginning</h3><p>Light a fresh fire in me. Show me that new beginnings are still possible, and lead me forward with courage.</p><a href="#share" aria-label="Save prayer for hope">Save prayer <span aria-hidden="true">↗</span></a></article>
      </div>
    </section>

    <section class="share-section section-frame" id="share" aria-labelledby="share-title">
      <div><p class="eyebrow">Pass it on</p><h2 id="share-title">A prayer shared<br><span>is a light multiplied.</span></h2></div>
      <a class="secondary-button" href="mailto:hello@freshfireprayers.com?subject=Prayer%20request">Send a prayer request <span aria-hidden="true">→</span></a>
    </section>
  </main>

  <footer class="site-footer section-frame">
    <span>© 2026 Fresh Fire Prayers</span>
    <span>Pray boldly. Live brightly.</span>
  </footer>
</body>
</html>
